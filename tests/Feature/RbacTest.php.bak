        );

        foreach ($expectedPermissions as $permissionSlug) {
            $this->assertDatabaseHas('permissions', [
                'slug' => $permissionSlug,
            ]);
        }
    }

    public function test_sales_role_has_expected_permissions(): void
    {
        $this->seed(RbacSeeder::class);

        $role = Role::where('slug', 'sales')->firstOrFail();

        $expectedPermissions = [
            'organizations.view',
            'organizations.create',
            'organizations.update',

            'contacts.view',
            'contacts.create',
            'contacts.update',

            'requirements.view',
            'requirements.create',
            'requirements.update',

            'quotations.view',
            'quotations.create',
            'quotations.update',
            'quotations.send',
            'quotations.cancel',

            'orders.view',
            'orders.create',

            'follow-ups.view',
            'follow-ups.create',
            'follow-ups.update',

            'specifications.view',
            'specifications.create',
            'specifications.update',
        ];

        $actualPermissions = $role->permissions()
            ->orderBy('slug')
            ->pluck('slug')
            ->all();

        sort($expectedPermissions);
        sort($actualPermissions);

        $this->assertSame(
            $expectedPermissions,
            $actualPermissions
        );
    }

    public function test_super_admin_has_every_seeded_permission(): void
    {
        $this->seed(RbacSeeder::class);

        $role = Role::where('slug', 'super-admin')->firstOrFail();

        $allPermissionSlugs = Permission::query()
            ->orderBy('slug')
            ->pluck('slug')
            ->all();

        $superAdminPermissionSlugs = $role->permissions()
            ->orderBy('slug')
            ->pluck('slug')
            ->all();

        $this->assertSame(
            $allPermissionSlugs,
            $superAdminPermissionSlugs
        );
    }

    public function test_rbac_seeder_is_idempotent(): void
    {
        $this->seed(RbacSeeder::class);

        $rolesBefore = Role::query()
            ->orderBy('slug')
            ->pluck('id', 'slug')
            ->all();

        $permissionsBefore = Permission::query()
            ->orderBy('slug')
            ->pluck('id', 'slug')
            ->all();

        $rolePermissionCountsBefore = [];

        foreach ($rolesBefore as $roleSlug => $roleId) {
            $rolePermissionCountsBefore[$roleSlug] = Role::findOrFail($roleId)
                ->permissions()
                ->count();
        }

        $this->seed(RbacSeeder::class);

        $this->assertDatabaseCount('roles', count($rolesBefore));
        $this->assertDatabaseCount(
            'permissions',
            count($permissionsBefore)
        );

        $rolesAfter = Role::query()
            ->orderBy('slug')
            ->pluck('id', 'slug')
            ->all();

        $permissionsAfter = Permission::query()
            ->orderBy('slug')
            ->pluck('id', 'slug')
            ->all();

        $this->assertSame($rolesBefore, $rolesAfter);
        $this->assertSame($permissionsBefore, $permissionsAfter);

        foreach ($rolesAfter as $roleSlug => $roleId) {
            $this->assertSame(
                $rolePermissionCountsBefore[$roleSlug],
                Role::findOrFail($roleId)
                    ->permissions()
                    ->count()
            );
        }
    }

    public function test_full_specification_access_roles_have_all_specification_permissions(): void
    {
        $this->seed(RbacSeeder::class);

        $permissionSlugs = [
            'specifications.view',
            'specifications.create',
            'specifications.update',
        ];

        foreach ([
            'super-admin',
            'admin',
            'sales',
        ] as $roleSlug) {
            $role = Role::where('slug', $roleSlug)
                ->firstOrFail();

            foreach ($permissionSlugs as $permissionSlug) {
                $this->assertTrue(
                    $role->permissions()
                        ->where('slug', $permissionSlug)
                        ->exists(),
                    "{$roleSlug} should have {$permissionSlug}"
                );
            }
        }
    }

    public function test_view_only_roles_have_view_specification_permission(): void
    {
        $this->seed(RbacSeeder::class);

        foreach ([
            'procurement',
            'production',
            'quality-control',
            'finance',
            'delivery',
        ] as $roleSlug) {
            $role = Role::where('slug', $roleSlug)
                ->firstOrFail();

            $this->assertTrue(
                $role->permissions()
                    ->where('slug', 'specifications.view')
                    ->exists(),
                "{$roleSlug} should have specifications.view"
            );

            $this->assertFalse(
                $role->permissions()
                    ->where('slug', 'specifications.create')
                    ->exists(),
                "{$roleSlug} should not have specifications.create"
            );

            $this->assertFalse(
                $role->permissions()
                    ->where('slug', 'specifications.update')
                    ->exists(),
                "{$roleSlug} should not have specifications.update"
            );
        }
    }
}